# Copy to .env (in the hw4/ root) and fill in real values. Never commit .env.
PORTKEY_API_KEY=your-portkey-api-key-here
# Optional: any OpenAI 5.6 / 6 series model available through your Portkey key
CHAT_MODEL=gpt-5.6-terra
# Optional: random string used to sign login cookies (auto-generated on first run if missing)
SESSION_SECRET=replace-with-a-long-random-string
# Optional: set to 1 when serving over HTTPS so session cookies are marked Secure
COOKIE_SECURE=0
